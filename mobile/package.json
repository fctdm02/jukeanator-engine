{
  "name": "jukeanator-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Capacitor wrapper that packages the JukeANator Web/Mobile UI as native iOS and Android apps.",
  "type": "module",
  "scripts": {
    "sync-web": "node scripts/sync-web.mjs",
    "sync": "npm run sync-web && cap sync",
    "android": "npm run sync && cap open android",
    "ios": "npm run sync && cap open ios",
    "assets": "capacitor-assets generate --iconBackgroundColor #000000 --iconBackgroundColorDark #000000 --splashBackgroundColor #000000 --splashBackgroundColorDark #000000"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2"
  }
}
